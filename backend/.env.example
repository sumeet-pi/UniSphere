# ============================================================================
# UniSphere Backend Environment Configuration (.env.example)
# ============================================================================

# Database Configuration (Neon Serverless PostgreSQL)
# Format: postgresql+psycopg://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql+psycopg://unisphere_owner:your_neon_password@ep-cool-resonance-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication & Security
SECRET_KEY=generate-a-strong-random-32-byte-secret-key-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
DEBUG=false

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://unisphere.college.edu
FRONTEND_URL=http://localhost:5173

# API Versioning & Docs Policy
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
