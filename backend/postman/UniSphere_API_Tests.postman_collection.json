        {
          "name": "POST /api/auth/register/student \u2014 Duplicate Email Registration (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Duplicate Vikram\",\n  \"email\": \"{{student_signup_email}}\",\n  \"password\": \"Password@2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register/student",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register",
                "student"
              ]
            },
            "description": "Attempts to register with an already existing student email. Expects 409 Conflict."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 409 Conflict\", function () { pm.response.to.have.status(409); });",
                  "pm.test(\"Error code is EMAIL_EXISTS\", function () { var json = pm.response.json(); pm.expect(json.detail.code).to.eql(\"EMAIL_EXISTS\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/login \u2014 Successful Student Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{student_signup_email}}\",\n  \"password\": \"Password@2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Login with student credentials returns token and General Student role."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test(\"User role is General Student\", function () { pm.expect(json.user.role).to.eql(\"General Student\"); });",
                  "if (json.access_token) { pm.collectionVariables.set(\"student_access_token\", json.access_token); }"
                ]
              }
            }
          ]
        },
