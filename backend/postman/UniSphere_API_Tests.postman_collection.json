    },
    {
      "key": "student_signup_email",
      "value": "",
      "type": "string"
    },
    {
      "key": "coordinator_email",
      "value": "",
      "type": "string"
    },
    {
      "key": "club_name",
      "value": "",
      "type": "string"
    },
    {
      "key": "student_access_token",
      "value": "",
